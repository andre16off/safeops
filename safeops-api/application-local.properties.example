# Copia este archivo como application-local.properties y completa los valores.
# application-local.properties no se sube al repositorio.

# Clave para firmar los tokens JWT: mínimo 32 caracteres, difícil de adivinar.
jwt.secret=

# Contraseñas de las cuentas iniciales (superadmin e invitado).
safeops.admin.password=
safeops.invitado.password=
